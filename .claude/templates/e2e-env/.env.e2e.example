# Srodowisko E2E dev-autopilot — DEDYKOWANY projekt Supabase (NIGDY dev ani prod!)
# Setup: .claude/templates/e2e-env/README.md
# Skopiuj ten plik do korzenia repo jako `.env.e2e` i uzupelnij wartosci.
# `.env.e2e` ma byc w .gitignore — start srodowiska odmowi, jesli nie jest.
# Sprawdzenie: node .claude/scripts/e2e/e2e.mjs sprawdz --zadanie docs/active/<zadanie>

# Serwer aplikacji (opcjonalne — domyslnie dev server Vite na 5173; opis w README):
# E2E_URL=http://localhost:5173
# E2E_START=pnpm run dev -- --mode e2e --port 5173 --strictPort
# E2E_HEALTH=http://localhost:5173
# E2E_START_TIMEOUT=90
# Projekt bez bazy e2e (bez katalogu supabase/) ustawia tylko E2E_URL i E2E_START i usuwa klucze ponizej (SUPABASE_E2E_* wlacza baze e2e i db-sync).

# Projekt e2e (Supabase dashboard -> Settings -> API). Vite laduje ten plik przez flage --mode e2e.
VITE_SUPABASE_URL=https://<ref-projektu-e2e>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key-projektu-e2e>   # sb_publishable_…; legacy: VITE_SUPABASE_ANON_KEY

# Polaczenie do bazy e2e (Settings -> Database -> Connection string).
# UWAGA: tryb "direct" (db.<ref>.supabase.co) jest IPv6-only — w sieciach bez trasy IPv6
# nie zadziala. Bezpieczniejszy default: SESSION POOLER (IPv4, port 5432, wspiera migracje):
SUPABASE_E2E_DB_URL=postgresql://postgres.<ref-projektu-e2e>:<haslo-db>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Service role (Settings -> API) — tylko do tworzenia konta testowego przez admin API
SUPABASE_E2E_SERVICE_ROLE_KEY=<service-role-key-projektu-e2e>

# Konto testowe do logowania w flow E2E przez agent-browser (email+haslo, NIE OAuth —
# popup providera OAuth jest niedostepny headless)
E2E_TEST_EMAIL=e2e@example.com
E2E_TEST_PASSWORD=<silne-haslo-testowe>
