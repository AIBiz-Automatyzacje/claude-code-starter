# Srodowisko E2E dev-autopilot — DEDYKOWANY projekt Supabase (NIGDY dev ani prod!)
# Setup: .claude/templates/e2e-env/README.md
# Skopiuj ten plik do korzenia repo jako `.env.e2e` i uzupelnij wartosci.
# `.env.e2e` ma byc w .gitignore — start srodowiska odmowi, jesli nie jest.
# Sprawdzenie: node .claude/scripts/e2e/e2e.mjs sprawdz --zadanie docs/active/<zadanie>

# Metro (opcjonalne — domyslnie `env -u CI <pm> expo start --port 8081`; opis w README).
# E2E_URL=http://localhost:8081
# E2E_START="env -u CI npx expo start --port 8081"   # w cudzyslowie: db-sync wczytuje plik shellem; bez `env -u CI` zapis env nie dotrze do paczki
# E2E_HEALTH=http://localhost:8081/status
# E2E_HEALTH_TRESC=packager-status:running
# E2E_START_TIMEOUT=90

# Urzadzenie (opcjonalne — domyslnie iOS bez konta Apple, a przy braku dzialajacy emulator Androida):
# E2E_PLATFORMA=ios   # ios albo android
# E2E_URZADZENIE="iPhone 17"   # nazwa albo UDID symulatora, serial adb

# Projekt bez bazy e2e (bez katalogu supabase/) usuwa klucze ponizej (SUPABASE_E2E_* wlacza baze e2e i db-sync).

# Projekt e2e (Supabase dashboard -> Settings -> API). Linie EXPO_PUBLIC_* adapter przepisuje do .env.development.local,
# a Expo wkompilowuje je w paczke: nie trzymaj w nich sekretow.
EXPO_PUBLIC_SUPABASE_URL=https://<ref-projektu-e2e>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key-projektu-e2e>   # sb_publishable_…; legacy: EXPO_PUBLIC_SUPABASE_ANON_KEY

# Polaczenie do bazy e2e (Settings -> Database -> Connection string).
# UWAGA: tryb "direct" (db.<ref>.supabase.co) jest IPv6-only — w sieciach bez trasy IPv6
# nie zadziala. Bezpieczniejszy default: SESSION POOLER (IPv4, port 5432, wspiera migracje):
SUPABASE_E2E_DB_URL=postgresql://postgres.<ref-projektu-e2e>:<haslo-db>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Service role (Settings -> API) — tylko do tworzenia konta testowego przez admin API
SUPABASE_E2E_SERVICE_ROLE_KEY=<service-role-key-projektu-e2e>

# Konto testowe do logowania w flow Maestro (email+haslo, NIE OAuth — Maestro nie przejdzie sheetu Google/Apple). Domena `.test`
# jest zarezerwowana na testy (RFC 6761), wiec mail nie trafi do nikogo. Podmien `<projekt>`.
# Ta sama tozsamosc jest tu dwa razy i wartosci musza byc IDENTYCZNE:
#   E2E_TEST_*        dla harnessu: login REST na starcie i `${MAESTRO_E2E_EMAIL}`/`${MAESTRO_E2E_PASSWORD}` w flow (srodowisko procesu Maestro);
#   EXPO_PUBLIC_*     dla aplikacji z przyciskiem dev sign-in. Bez tej pary przycisk sie nie renderuje i kazdy flow pada na
#                     pierwszym `tapOn`, a start tego nie zglosi. Aplikacja z formularzem logowania tej pary nie potrzebuje.
# Seed z mailem na sztywno (`select id from auth.users where email=`) musi miec TEN SAM mail.
E2E_TEST_EMAIL=e2e@<projekt>.test
E2E_TEST_PASSWORD=<silne-haslo-testowe>
EXPO_PUBLIC_E2E_TEST_USER_EMAIL=e2e@<projekt>.test
EXPO_PUBLIC_E2E_TEST_USER_PASSWORD=<silne-haslo-testowe>

# Opcjonalnie: lint advisors (RLS, search_path, indeksy) bazy e2e po migracjach kazdej fazy — wynik dostaje reviewer
# security. Supabase -> Account -> Access Tokens. Token daje dostep do CALEGO konta Supabase (takze dev i prod);
# pipeline wysyla go tylko do Management API, nie do procesu aplikacji. Bez tokenu security sprawdza migracje recznie.
# SUPABASE_ACCESS_TOKEN=<token-management-api>
