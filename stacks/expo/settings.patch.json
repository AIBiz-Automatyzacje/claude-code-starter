{
  "permissions": {
    "deny": [
      "Bash(npx --yes @expo/agent-cli*)",
      "Bash(npx @expo/agent-cli*)",
      "Bash(*agent-cli*feedback*)",
      "Bash(*submit-expo-feedback*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/mobile-anti-pattern-check.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dev-browser@dev-browser-marketplace": null,
    "expo@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "dev-browser-marketplace": null
  }
}
