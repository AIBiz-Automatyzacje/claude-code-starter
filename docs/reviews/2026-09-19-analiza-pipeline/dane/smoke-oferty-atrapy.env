# Atrapy zmiennych dla kopii oferty-online do smoke'a (przygotuj-kopie.sh --env). BEZ sekretow.
# Dashboard rzuca przy imporcie bez VITE_SUPABASE_URL (envDir = root repo), a .env.example ma puste wartosci;
# 4 testy mapy uwagi w offer-details-page.test.tsx czytaja VITE_OFFER_ORIGIN z .env (bez vi.stubEnv) — publiczny adres, nie sekret.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=atrapa-smoke
VITE_OFFER_ORIGIN=https://traferto.pl
